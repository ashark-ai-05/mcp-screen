{
  "name": "mcp-screen",
  "version": "0.1.1",
  "mcpName": "io.github.ashark-ai-05/mcp-screen",
  "description": "MCP server that gives terminal agents a screen: an infinite canvas of charts, diffs, diagrams, logs and MCP Apps next to Claude Code, Codex, Cursor, Gemini CLI, Amp and opencode. Circle anything to ask the agent about it.",
  "main": "dist/cli.js",
  "scripts": {
    "build": "tsc -p . && chmod +x dist/cli.js",
    "typecheck": "tsc -p . --noEmit && tsc -p test/tsconfig.json --noEmit",
    "test": "vitest run",
    "dev": "npm run build && node dist/cli.js serve",
    "screenshots": "npm run build && node scripts/e2e.mjs",
    "prepublishOnly": "npm run build && npm test",
    "interop": "npm run build && node scripts/ext-apps-check.mjs",
    "demo": "npm run build && node scripts/record-demo.mjs",
    "ux": "npm run build && node scripts/ux.mjs",
    "soak": "npm run build && node scripts/soak.mjs",
    "perf": "npm run build && node scripts/perf.mjs"
  },
  "keywords": [
    "mcp",
    "mcp-server",
    "model-context-protocol",
    "mcp-apps",
    "claude",
    "claude-code",
    "codex",
    "cursor",
    "gemini-cli",
    "opencode",
    "amp",
    "ai-agents",
    "coding-agent",
    "canvas",
    "widgets",
    "visualization",
    "dashboard",
    "charts",
    "annotations",
    "human-in-the-loop"
  ],
  "author": "Krunal Ashar",
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "picomatch": "^4.0.7",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/picomatch": "^4.0.3",
    "playwright": "1.59",
    "typescript": "^7.0.2",
    "vitest": "^5.0.4"
  },
  "type": "module",
  "bin": {
    "mcp-screen": "dist/cli.js"
  },
  "files": [
    "dist",
    "public",
    "README.md",
    "SECURITY.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/ashark-ai-05/mcp-screen"
  },
  "homepage": "https://github.com/ashark-ai-05/mcp-screen#readme",
  "bugs": {
    "url": "https://github.com/ashark-ai-05/mcp-screen/issues"
  }
}
